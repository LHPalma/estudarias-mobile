# Copie para .env.local (fora do git) e ajuste. O Expo embute as variáveis EXPO_PUBLIC_* no app na hora do build.

# A API do back. No celular, use o IP da sua máquina na rede (localhost é o próprio celular).
EXPO_PUBLIC_API_URL=http://192.168.0.10:5007

# true: o app responde do modo mock, sem rede e sem o back.
EXPO_PUBLIC_API_MOCK=true

# No modo mock, o grupo experimental do aluno: diagnostic ou control.
EXPO_PUBLIC_MOCK_GROUP=diagnostic
